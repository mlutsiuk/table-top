datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

generator json {
  provider  = "prisma-json-types-generator"
  namespace = "PrismaJson"
}

/// Who may see a folder or asset. `master_only` hides the node and, for folders,
/// everything beneath it — inheritance is resolved from `Folder.path`.
enum MaterialVisibility {
  public
  master_only
}

enum CampaignStatus {
  draft
  active
  archived
}

model User {
  id            String           @id @default(uuid())
  email         String           @unique
  name          String
  createdAt     DateTime         @default(now()) @map("created_at")

  campaigns     Campaign[]
  memberships   CampaignMember[]

  @@map("users")
}

model Campaign {
  id              String           @id @default(uuid())
  title           String
  createdAt       DateTime         @default(now()) @map("created_at")
  status          CampaignStatus   @default(draft)

  masterId        String           @map("master_id")
  master          User             @relation(fields: [masterId], references: [id])

  media           Media[]
  folders         Folder[]
  assets          Asset[]
  traitDefs       TraitDef[]
  entities        Entity[]
  members         CampaignMember[]

  @@index([masterId])
  @@map("campaigns")
}

model CampaignMember {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now()) @map("created_at")

  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId])
  @@map("campaign_members")
}

model Media {
  id         String   @id @default(uuid())
  url        String
  key        String
  name       String
  type       String
  size       Int
  createdAt  DateTime @default(now()) @map("created_at")

  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("media")
}

model Folder {
  id          String   @id @default(uuid())
  title       String
  visibility  MaterialVisibility @default(public)

  /// Denormalized folder path, self-inclusive
  path        String[]

  parentId    String?  @map("parent_id")
  parent      Folder?  @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)

  campaignId  String   @map("campaign_id")
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  assets      Asset[]
  subFolders  Folder[] @relation("SubFolders")

  @@index([campaignId])
  @@index([parentId])
  /// Containment (`path @> ARRAY[id]`) is how a whole subtree is selected on move.
  @@index([path], type: Gin)
  @@map("folders")
}

model Asset {
  id          String   @id @default(uuid())
  title       String
  content     Json?
  visibility  MaterialVisibility @default(public)

  campaignId  String   @map("campaign_id")
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  folderId    String  @map("folder_id")
  folder      Folder  @relation(fields: [folderId], references: [id], onDelete: Cascade)

  traits      AssetTrait[]
  entities    Entity[]

  @@index([campaignId])
  @@index([folderId])
  @@map("assets")
}

/// A set of fields declared for one campaign: the engine's only way to store values
/// (ADR-013). Holds no values itself; those live in AssetTrait and EntityTrait.
model TraitDef {
  id         String   @id @default(uuid())
  /// Identifier that formulas address, e.g. `@core_stats.str`. Fixed after creation.
  key        String
  /// What the master sees. Renaming it never breaks a formula.
  label      String
  /// [RawTraitConfig]
  config     Json

  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  assetTraits  AssetTrait[]
  entityTraits EntityTrait[]

  @@unique([campaignId, key])
  @@unique([campaignId, label])
  @@map("trait_defs")
}

model AssetTrait {
  id         String   @id @default(uuid())
  /// [AssetTraitData]
  data       Json

  assetId    String   @map("asset_id")
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  traitDefId String   @map("trait_def_id")
  traitDef   TraitDef @relation(fields: [traitDefId], references: [id], onDelete: Cascade)

  @@unique([assetId, traitDefId])
  @@index([traitDefId])
  @@map("asset_traits")
}

model Entity {
  id         String   @id @default(uuid())

  assetId    String   @map("asset_id")
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  entityTraits   EntityTrait[]
  relationsFrom  EntityRelation[] @relation("RelationSource")
  relationsTo    EntityRelation[] @relation("RelationTarget")

  @@index([assetId])
  @@index([campaignId])
  @@map("entities")
}

model EntityTrait {
  id         String   @id @default(uuid())
  /// [EntityTraitData]
  data       Json

  entityId   String   @map("entity_id")
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  traitDefId String   @map("trait_def_id")
  traitDef   TraitDef @relation(fields: [traitDefId], references: [id], onDelete: Cascade)

  @@unique([entityId, traitDefId])
  @@index([traitDefId])
  @@map("entity_traits")
}

model EntityRelation {
  id       String  @id @default(uuid())
  key      String
  /// [EntityRelationData]
  data     Json?

  sourceId String  @map("source_id")
  source   Entity  @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)

  targetId String  @map("target_id")
  target   Entity  @relation("RelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([sourceId, key])
  @@index([targetId, key])
  @@map("entity_relations")
}