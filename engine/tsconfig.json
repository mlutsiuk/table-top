{
  // `engine/` sits outside app/ server/ shared/, so no generated Nuxt project
  // covers it. Without this the compile-time guarantees in the registries —
  // Record<MechanicKey, …> and Record<FieldType, …> — would never be checked.
  "extends": "../.nuxt/tsconfig.shared.json",
  "include": ["**/*.ts", "**/*.vue"]
}
